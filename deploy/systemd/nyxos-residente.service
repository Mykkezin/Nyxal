[Unit]
Description=NyxOS — ciclo operacional residente
StartLimitIntervalSec=300
StartLimitBurst=10
After=nyxal-api.service
Wants=nyxal-api.service

[Service]
Type=simple
WorkingDirectory=%h/Nyxal
ExecStart=%h/Nyxal/.venv/bin/python %h/Nyxal/executar_nyxos_residente.py --intervalo 5 --continuar-em-erro --habilitar-aprendizado --habilitar-auto-experimento
EnvironmentFile=-%h/.config/nyxal/nyxal.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectClock=true
ProtectKernelLogs=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
PrivateTmp=true
UMask=0077

[Install]
WantedBy=nyxos.target
