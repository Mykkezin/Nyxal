[Unit]
Description=NyxOS — ciclo operacional residente
After=nyxal-api.service
Wants=nyxal-api.service

[Service]
Type=simple
WorkingDirectory=%h/Nyxal
ExecStart=/usr/bin/python3 %h/Nyxal/executar_nyxos_residente.py --intervalo 5
EnvironmentFile=-%h/.config/nyxal/nyxal.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=nyxos.target
