# Exemplo opcional: AMD Developer Cloud via servidor OpenAI-compatible
# Copie os valores necessários para ~/.config/nyxal/nyxal.env.
# Recomenda-se usar túnel SSH e deixar o endpoint remoto sem exposição pública.
NYXAL_LLM_PROVIDER=amd_cloud
NYXAL_AMD_CLOUD_BASE_URL=http://127.0.0.1:8000/v1
NYXAL_AMD_CLOUD_MODEL=Qwen/Qwen2.5-7B-Instruct
NYXAL_AMD_CLOUD_API_KEY=
