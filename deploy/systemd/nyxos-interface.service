[Unit]
Description=NyxOS — desktop principal residente
After=graphical-session-pre.target nyxal-api.service
Before=graphical-session.target
Wants=nyxal-api.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Nyxal
ExecStart=%h/Nyxal/deploy/systemd/iniciar_nyxos_shell.sh
Environment=XDG_RUNTIME_DIR=%t
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
